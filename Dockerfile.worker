# syntax=docker/dockerfile:1.6
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl && corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/db/prisma packages/db/prisma
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/pdf/package.json packages/pdf/package.json
COPY packages/storage/package.json packages/storage/package.json
RUN pnpm install --frozen-lockfile

FROM base AS dev
# The same Chromium and fonts as the production image, so local PDFs look the same.
RUN apk add --no-cache chromium nss freetype harfbuzz font-liberation font-dejavu
COPY . .
CMD ["sh", "-c", "pnpm --filter @cota/config --filter @cota/db --filter @cota/i18n --filter @cota/storage --filter @cota/pdf build && pnpm --filter worker dev"]

FROM base AS build
COPY . .
RUN pnpm --filter worker... build
# Same layout as the API image: production dependencies only, compiled
# workspace packages and the Prisma client generated at install time.
RUN pnpm --filter worker deploy --prod --ignore-scripts --config.node-linker=isolated /out \
 && for pacote in config db pdf storage; do test -f /out/node_modules/.pnpm/file+packages+$pacote/node_modules/@cota/$pacote/dist/index.js; done \
 && for cliente in /out/node_modules/.pnpm/@prisma+client@*/node_modules; do cp -R node_modules/.prisma "$cliente/"; done \
 && test -f /out/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma/client/index.js \
 && rm -rf /out/src /out/tsconfig.json

FROM node:22-alpine AS runtime
WORKDIR /app
# The Lambda Chromium build bundled with @sparticuz/chromium needs glibc, so
# the image uses Alpine's Chromium. Liberation (metric-compatible with Arial
# and Times) and DejaVu cover the Latin text of the proposals.
RUN apk add --no-cache libc6-compat openssl chromium nss freetype harfbuzz font-liberation font-dejavu
# Chromium's sandbox needs user namespaces, which this non-root container
# without capabilities doesn't have: the container isolates it instead, and
# pages print with JavaScript off and only public https requests allowed.
ENV NODE_ENV=production \
    CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    PDF_CHROMIUM_SANDBOX=false
COPY --from=build --chown=node:node /out ./
USER node
CMD ["node", "dist/main.js"]
