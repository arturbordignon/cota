generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  defaultLocale  String    @default("pt-BR")
  settingsJson   Json
  stripeCustomerId String? @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  clients        Client[]
  equipment      Equipment[]
  templates      ProposalTemplate[]
  proposals      Proposal[]
  savedFields    SavedFieldSet[]
  auditEvents    AuditEvent[]
  subscriptions  Subscription[]
  proposalUsages ProposalUsage[]
  departments    Department[]
  prospects      Prospect[]
  pipelineStages PipelineStage[]
  pipelineLeads  PipelineLead[]
  notifications  Notification[]
  currentPlanId  String?
  currentPlan    Plan?     @relation(fields: [currentPlanId], references: [id])
  assets         ProposalAsset[]
}

model User {
  id              String    @id @default(uuid())
  accountId       String
  email           String
  fullName        String?
  passwordHash    String
  jobTitle        String?
  role            UserRole  @default(MEMBER)
  preferredLocale String    @default("pt-BR")
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  departmentId    String?
  invitedById     String?
  inviteTokenHash  String?  @unique
  inviteTokenExpiresAt DateTime?
  invitedAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdProposals Proposal[] @relation("ProposalCreator")
  auditEvents     AuditEvent[]
  receivedNotifications Notification[] @relation("NotificationRecipient")
  department      Department? @relation(fields: [departmentId], references: [id])
  invitedBy       User?      @relation("UserInvites", fields: [invitedById], references: [id])
  invitedMembers  User[]     @relation("UserInvites")

  @@unique([accountId, email])
  @@index([departmentId])
}

model Department {
  id               String              @id @default(uuid())
  accountId        String
  name             String
  slug             String
  description      String?
  permissionPreset DepartmentPreset?   @default(VIEW)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members          User[]
  permissions      DepartmentPermission[]

  @@index([accountId])
  @@unique([accountId, slug])
}

model DepartmentPermission {
  id            String            @id @default(uuid())
  departmentId  String
  module        PermissionModule
  canView       Boolean           @default(false)
  canEdit       Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  department    Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@unique([departmentId, module])
}

enum DepartmentPreset {
  NONE
  VIEW
  ALL
  CUSTOM
}

enum PermissionModule {
  DASHBOARD
  PROPOSALS
  TEMPLATES
  PROSPECTS
  CRM
  REPORTS
  PLAN
  CLIENTS
  SERVICES
}

enum UserRole {
  OWNER
  MEMBER
}

model Client {
  id          String   @id @default(uuid())
  accountId   String
  name        String
  companyName String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proposals   Proposal[]

  @@index([accountId])
}

model Equipment {
  id           String   @id @default(uuid())
  accountId    String
  name         String
  capacityTons Float?
  dailyRate    Decimal? @db.Decimal(12, 2)
  specsJson    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model ProposalTemplate {
  id                   String    @id @default(uuid())
  accountId            String?
  name                 String
  description          String?
  locale               String    @default("pt-BR")
  category             String?
  inputSchemaJson      Json
  defaultDataJson      Json
  htmlBody             String
  pdfLayoutOptionsJson Json
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  account              Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proposals            Proposal[]

  @@index([accountId])
}

model Proposal {
  id              String       @id @default(uuid())
  accountId       String
  templateId      String
  clientId        String?
  createdById     String
  title           String
  locale          String       @default("pt-BR")
  status          ProposalStatus @default(DRAFT)
  payloadJson     Json
  totalsJson      Json
  publicSlug      String        @unique
  pdfObjectKey    String?
  webObjectKey    String?
  expiresAt       DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  pipelineLeadId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template        ProposalTemplate @relation(fields: [templateId], references: [id])
  client          Client?       @relation(fields: [clientId], references: [id])
  createdBy       User          @relation("ProposalCreator", fields: [createdById], references: [id])
  assets          ProposalAsset[]
  pipelineLead    PipelineLead? @relation("LeadProposals", fields: [pipelineLeadId], references: [id])

  @@index([accountId])
  @@index([publicSlug])
}

enum ProposalStatus {
  DRAFT
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model ProposalAsset {
  id          String   @id @default(uuid())
  proposalId  String
  accountId   String
  s3ObjectKey String
  mimeType    String
  position    Int
  createdAt   DateTime @default(now())

  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Prospect {
  id          String   @id @default(uuid())
  accountId   String
  name        String
  segment     String?
  region      String?
  city        String?
  state       String?
  opportunity String?
  email       String?
  phone       String?
  notesJson   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  leads       PipelineLead[]

  @@index([accountId])
  @@index([accountId, segment])
  @@index([accountId, region])
}

model PipelineStage {
  id        String   @id @default(uuid())
  accountId String
  name      String
  color     String   @default("info")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  leads     PipelineLead[]

  @@index([accountId])
  @@unique([accountId, name])
}

model PipelineLead {
  id             String    @id @default(uuid())
  accountId      String
  stageId        String
  prospectId     String?
  companyName    String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  estimatedValue Decimal? @db.Decimal(14, 2)
  notes          String?
  metadataJson   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  prospect       Prospect?     @relation(fields: [prospectId], references: [id])
  proposals      Proposal[]    @relation("LeadProposals")

  @@index([accountId])
  @@index([stageId])
  @@index([prospectId])
}

model SavedFieldSet {
  id         String  @id @default(uuid())
  accountId  String
  key        String
  payloadJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
}

model AuditEvent {
  id         String   @id @default(uuid())
  accountId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  summary    String
  ipAddress  String?
  userAgent  String?
  metadataJson Json
  createdAt  DateTime @default(now())

  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user       User?   @relation(fields: [userId], references: [id])

  @@index([accountId])
}

model Notification {
  id           String           @id @default(uuid())
  accountId    String
  recipientId  String?
  title        String
  body         String
  tone         NotificationTone @default(INFO)
  metadataJson Json?
  isRead       Boolean          @default(false)
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipient    User?            @relation("NotificationRecipient", fields: [recipientId], references: [id])
  logs         NotificationLog[]

  @@index([accountId])
  @@index([recipientId])
}

model NotificationLog {
  id              String               @id @default(uuid())
  notificationId  String
  event           NotificationLogEvent @default(CREATED)
  detailsJson     Json?
  createdAt       DateTime             @default(now())

  notification    Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
}

enum NotificationTone {
  SUCCESS
  INFO
  WARNING
  DANGER
}

enum NotificationLogEvent {
  CREATED
  DISPATCHED
  READ
  ARCHIVED
  ERROR
}

model Plan {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  currency         String
  amountCents      Int?
  stripePriceId    String?
  proposalsPerMonth Int?
  isUnlimited      Boolean        @default(false)
  isAnnual         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions    Subscription[]
  accounts         Account[]
}

model Subscription {
  id                   String        @id @default(uuid())
  accountId            String
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?       @unique
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  account              Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan                 Plan          @relation(fields: [planId], references: [id])

  @@index([accountId])
  @@index([planId])
}

model ProposalUsage {
  id           String   @id @default(uuid())
  accountId    String
  periodStart  DateTime
  periodEnd    DateTime
  proposalsUsed Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodStart, periodEnd])
}
