generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  defaultLocale  String    @default("pt-BR")
  settingsJson   Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  clients        Client[]
  equipment      Equipment[]
  templates      ProposalTemplate[]
  proposals      Proposal[]
  savedFields    SavedFieldSet[]
  auditEvents    AuditEvent[]
  subscriptions  Subscription[]
  proposalUsages  ProposalUsage[]
  currentPlanId  String?
  currentPlan    Plan?     @relation(fields: [currentPlanId], references: [id])
  assets         ProposalAsset[]
}

model User {
  id              String    @id @default(uuid())
  accountId       String
  email           String
  passwordHash    String
  role            UserRole  @default(MEMBER)
  preferredLocale String    @default("pt-BR")
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdProposals Proposal[] @relation("ProposalCreator")
  auditEvents     AuditEvent[]

  @@unique([accountId, email])
}

enum UserRole {
  OWNER
  MEMBER
}

model Client {
  id          String   @id @default(uuid())
  accountId   String
  name        String
  companyName String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proposals   Proposal[]

  @@index([accountId])
}

model Equipment {
  id           String   @id @default(uuid())
  accountId    String
  name         String
  capacityTons Float?
  dailyRate    Decimal? @db.Decimal(12, 2)
  specsJson    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model ProposalTemplate {
  id                   String    @id @default(uuid())
  accountId            String?
  name                 String
  description          String?
  locale               String    @default("pt-BR")
  category             String?
  inputSchemaJson      Json
  defaultDataJson      Json
  htmlBody             String
  pdfLayoutOptionsJson Json
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  account              Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proposals            Proposal[]

  @@index([accountId])
}

model Proposal {
  id              String       @id @default(uuid())
  accountId       String
  templateId      String
  clientId        String?
  createdById     String
  title           String
  locale          String       @default("pt-BR")
  status          ProposalStatus @default(DRAFT)
  payloadJson     Json
  totalsJson      Json
  publicSlug      String        @unique
  pdfObjectKey    String?
  webObjectKey    String?
  expiresAt       DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template        ProposalTemplate @relation(fields: [templateId], references: [id])
  client          Client?       @relation(fields: [clientId], references: [id])
  createdBy       User          @relation("ProposalCreator", fields: [createdById], references: [id])
  assets          ProposalAsset[]

  @@index([accountId])
  @@index([publicSlug])
}

enum ProposalStatus {
  DRAFT
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model ProposalAsset {
  id          String   @id @default(uuid())
  proposalId  String
  accountId   String
  s3ObjectKey String
  mimeType    String
  position    Int
  createdAt   DateTime @default(now())

  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model SavedFieldSet {
  id         String  @id @default(uuid())
  accountId  String
  key        String
  payloadJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
}

model AuditEvent {
  id         String   @id @default(uuid())
  accountId  String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadataJson Json
  createdAt  DateTime @default(now())

  account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user       User?   @relation(fields: [userId], references: [id])

  @@index([accountId])
}

model Plan {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  currency         String
  amountCents      Int?
  stripePriceId    String?
  proposalsPerMonth Int?
  isUnlimited      Boolean        @default(false)
  isAnnual         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions    Subscription[]
  accounts         Account[]
}

model Subscription {
  id                   String        @id @default(uuid())
  accountId            String
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  account              Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan                 Plan          @relation(fields: [planId], references: [id])

  @@index([accountId])
  @@index([planId])
}

model ProposalUsage {
  id           String   @id @default(uuid())
  accountId    String
  periodStart  DateTime
  periodEnd    DateTime
  proposalsUsed Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodStart, periodEnd])
}
