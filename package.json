{
  "name": "cota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "local:up": "sh ./scripts/local-up.sh",
    "local:down": "sh ./scripts/local-down.sh",
    "local:seed": "node ./scripts/local-seed-demo.mjs",
    "local:reset": "node ./scripts/local-seed-demo.mjs --reset",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter worker dev",
    "migrate:dev": "pnpm --filter db run prisma:migrate",
    "generate": "pnpm --filter db run prisma:generate",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "dev:mcp": "pnpm --filter mcp start"
  },
  "devDependencies": {
    "eslint-import-resolver-typescript": "^4.4.4"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.7",
      "@fastify/cors": "11.3.1",
      "@fastify/helmet": "13.2.0",
      "@fastify/rate-limit": "10.3.0",
      "@fastify/redis": "7.2.0",
      "@fastify/static": "10.1.6",
      "@fastify/swagger": "9.9.2",
      "@fastify/swagger-ui": "6.1.2",
      "fast-uri@3": "^3.1.7",
      "postcss@8": "^8.5.18",
      "nanoid@3": "^3.3.18",
      "source-map-js@1": "^1.2.2",
      "qs@6": "^6.16.1",
      "ajv@8": "^8.20.0",
      "yaml@2": "^2.9.1",
      "bn.js@4": "^4.12.5",
      "uuid@11": "^11.1.1"
    }
  }
}
