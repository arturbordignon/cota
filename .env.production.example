# Copy to .env.production and fill every value. The API refuses to start in
# production with the sample secrets from .env.example, short JWT secrets, the
# local MinIO or database passwords, a non-https frontend, or Stripe without a
# webhook secret. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
# Proxies allowed to set X-Forwarded-For (uniquelocal = private ranges, as with an ALB in a VPC)
TRUST_PROXY=uniquelocal
RATE_LIMIT_MAX=200

# Database and Redis (the compose file also reads these two passwords)
POSTGRES_USER=cota
POSTGRES_DB=cota
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cota:<POSTGRES_PASSWORD>@postgres:5432/cota?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Tokens: two different random values of at least 32 characters
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public addresses
FRONTEND_BASE_URL=https://app.example.com
CDN_BASE_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Private S3 bucket (no public access; files are served with signed URLs)
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
QUEUE_PREFIX=cota
PDF_RENDER_TIMEOUT_MS=120000

# Stripe: the webhook secret is required whenever the API key is set
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BR_50=
STRIPE_PRICE_BR_50_ANNUAL=
STRIPE_PRICE_BR_100=
STRIPE_PRICE_BR_100_ANNUAL=
STRIPE_PRICE_BR_UNLIMITED=
STRIPE_PRICE_BR_UNLIMITED_ANNUAL=
STRIPE_PRICE_US_50=
STRIPE_PRICE_US_50_ANNUAL=
STRIPE_PRICE_US_100=
STRIPE_PRICE_US_100_ANNUAL=
STRIPE_PRICE_US_UNLIMITED=
STRIPE_PRICE_US_UNLIMITED_ANNUAL=

# Email
EMAIL_FROM=convites@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
