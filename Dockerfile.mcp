# syntax=docker/dockerfile:1.6
# The hosted MCP server (apps/mcp, src/http-main.ts) that people connect from
# Claude or ChatGPT. It only talks to the API over HTTP and keeps OAuth state
# in Redis, so it needs no workspace packages and no database access.
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat && corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/mcp/package.json apps/mcp/package.json
RUN pnpm install --frozen-lockfile --filter mcp...

FROM base AS build
COPY apps/mcp apps/mcp
RUN pnpm --filter mcp build
# A self-contained copy with production dependencies only.
RUN pnpm --filter mcp deploy --prod --ignore-scripts --config.node-linker=isolated /out \
 && test -f /out/dist/http-main.js \
 && rm -rf /out/src /out/test /out/tsconfig.json

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /out ./
USER node
EXPOSE 3334
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3334/health >/dev/null || exit 1
CMD ["node", "dist/http-main.js"]
